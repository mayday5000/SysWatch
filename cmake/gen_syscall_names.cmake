# Generates syscall_names.inc: one "{nr, "name"}," line per native syscall
# of the architecture the TUI is compiled for. It preprocesses
# <sys/syscall.h> with the project's own C++ compiler and flags, so a
# 32-bit or cross build gets that target's numbers.
#
#   cmake -DCXX=<compiler> -DCXX_FLAGS=<list> -DOUT=<file> -P gen_syscall_names.cmake

if(NOT CXX OR NOT OUT)
    message(FATAL_ERROR "gen_syscall_names: CXX and OUT are required")
endif()

get_filename_component(out_dir "${OUT}" DIRECTORY)
set(probe "${out_dir}/syscall_names_probe.cpp")
file(WRITE "${probe}" "#include <sys/syscall.h>\n")
execute_process(
    COMMAND "${CXX}" ${CXX_FLAGS} -dM -E -x c++ "${probe}"
    OUTPUT_VARIABLE defines
    ERROR_VARIABLE err
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "gen_syscall_names: preprocessing <sys/syscall.h> failed:\n${err}")
endif()

# Collect every "#define __NR_<name> <value>". Values are either numbers or
# other macros (arm64/riscv: __NR_mmap -> __NR3264_mmap -> 222).
string(REPLACE "\n" ";" lines "${defines}")
set(names "")
foreach(line IN LISTS lines)
    if(line MATCHES "^#define (__NR[A-Za-z0-9_]*) +(.+)$")
        set(macro "${CMAKE_MATCH_1}")
        string(STRIP "${CMAKE_MATCH_2}" value)
        set("val_${macro}" "${value}")
        if(macro MATCHES "^__NR_([A-Za-z0-9_]+)$")
            list(APPEND names "${CMAKE_MATCH_1}")
        endif()
    endif()
endforeach()

set(entries "")
foreach(name IN LISTS names)
    # Placeholders from asm-generic, not syscalls.
    if(name STREQUAL "syscalls" OR name STREQUAL "arch_specific_syscall")
        continue()
    endif()
    set(v "${val___NR_${name}}")
    # Resolve macro aliases a few levels deep.
    foreach(i RANGE 4)
        if(v MATCHES "^[0-9]+$")
            break()
        endif()
        if(DEFINED "val_${v}")
            set(v "${val_${v}}")
        else()
            break()
        endif()
    endforeach()
    if(v MATCHES "^[0-9]+$")
        # Zero-pad so a plain string sort is a numeric sort.
        string(LENGTH "${v}" len)
        math(EXPR pad "6 - ${len}")
        string(REPEAT "0" ${pad} zeros)
        list(APPEND entries "${zeros}${v}|${name}")
    endif()
endforeach()
list(SORT entries)
list(REMOVE_DUPLICATES entries)

list(LENGTH entries count)
if(count EQUAL 0)
    message(FATAL_ERROR "gen_syscall_names: no __NR_* numbers found in <sys/syscall.h>")
endif()

set(text "/* Generated by cmake/gen_syscall_names.cmake from <sys/syscall.h>. Do not edit. */\n")
foreach(e IN LISTS entries)
    string(REPLACE "|" ";" parts "${e}")
    list(GET parts 0 nr)
    list(GET parts 1 name)
    math(EXPR nr "${nr}")
    string(APPEND text "{${nr}, \"${name}\"},\n")
endforeach()

# Only touch the file when it changes, so dependents are not rebuilt.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL text)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${text}")
message(STATUS "gen_syscall_names: ${count} syscalls -> ${OUT}")
