# SPDX-License-Identifier: MIT
# Kernel config fragment for the SysWatch QEMU tests. Apply on top of
# x86_64_defconfig (build-kernel.sh does this):
#   make x86_64_defconfig && scripts/kconfig/merge_config.sh -m .config debug.config && make olddefconfig
#
# Syscall tracepoints (the module hooks sys_enter)
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_TRACEPOINTS=y
# Modules, unsigned
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG is not set
# 32-bit tasks and 32-bit ioctl callers (kmod_test32)
CONFIG_IA32_EMULATION=y
CONFIG_COMPAT=y
# Preemptible kernel: before 6.13 the probe then runs with preemption
# disabled, which DEBUG_ATOMIC_SLEEP checks
CONFIG_PREEMPT=y
# Debugging
CONFIG_EXPERT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_PROVE_LOCKING=y
CONFIG_LOCKDEP=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
# initramfs, serial console, devtmpfs, ptys
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_UNIX98_PTYS=y
